#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&sk { release-after-ms = <3000>; };

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        sec_kp_kp: sec_kp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "SEC_KP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        num: num {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM";
            bindings = <&kp>, <&en>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        twin_e_mac: twin_e_mac {
            compatible = "zmk,behavior-tap-dance";
            label = "TWIN_E_MAC";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_IE>, <&kp BACKSLASH>;
        };

        twin_sign: twin_sign {
            compatible = "zmk,behavior-tap-dance";
            label = "TWIN_SIGN";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_SOFT_SIGN>, <&kp RU_CYRILLIC_HARD_SIGN>;
        };

        braces: braces {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACES";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        brackets: brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        parenth: parenth {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENTH";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        lt_gt: lt_gt {
            compatible = "zmk,behavior-tap-dance";
            label = "LT_GT";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;
        };

        braces_ru: braces_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACES_RU";
            #binding-cells = <0>;
            bindings = <&en LEFT_BRACE>, <&en RIGHT_BRACE>;
        };

        brackets_ru: brackets_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS_RU";
            #binding-cells = <0>;
            bindings = <&en LEFT_BRACKET>, <&en RIGHT_BRACKET>;
        };

        lt_gt_ru: lt_gt_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "LT_GT_RU";
            #binding-cells = <0>;
            bindings = <&en LESS_THAN>, <&en GREATER_THAN>;
        };

        colons: colons {
            compatible = "zmk,behavior-tap-dance";
            label = "COLONS";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMICOLON>;
        };

        colons_ru_mac: colons_ru_mac {
            compatible = "zmk,behavior-tap-dance";
            label = "COLONS_RU_MAC";
            #binding-cells = <0>;
            bindings = <&kp PERCENT>, <&kp ASTERISK>;
        };

        eq_not: eq_not {
            compatible = "zmk,behavior-tap-dance";
            label = "EQ_NOT";
            #binding-cells = <0>;
            bindings = <&kp KP_EQUAL>, <&kp EXCLAMATION>;
        };

        sent_end: sent_end {
            compatible = "zmk,behavior-tap-dance";
            label = "SENTENCE_END";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;
        };

        quotes: quotes {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTES";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        quotes_ru: quotes_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTES_RU";
            #binding-cells = <0>;
            bindings = <&en SINGLE_QUOTE>, <&kp AT_SIGN>;
        };

        pipe_ctrl_dash: pipe_ctrl_dash {
            compatible = "zmk,behavior-tap-dance";
            label = "PIPE_CTRL_DASH";
            #binding-cells = <0>;
            bindings = <&mt RCTRL PIPE>, <&kp KP_MINUS>;

            tapping-term-ms = <300>;
        };

        caret_dollar: caret_dollar {
            compatible = "zmk,behavior-tap-dance";
            label = "CARET_DOLLAR";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp DOLLAR>;
        };

        caret_dollar_ru: caret_dollar_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "CARET_DOLLAR_RU";
            #binding-cells = <0>;
            bindings = <&en CARET>, <&en DOLLAR>;
        };

        dash_alt_hyphen: dash_alt_hyphen {
            compatible = "zmk,behavior-tap-dance";
            label = "DASH_ALT_HYPHEN";
            #binding-cells = <0>;
            bindings = <&mt LALT MINUS>, <&kp LA(UNDERSCORE)>;

            tapping-term-ms = <300>;
        };

        plus_alt: plus_alt {
            compatible = "zmk,behavior-tap-dance";
            label = "PLUS_ALT";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp LA(PLUS)>;
        };

        mt_en: mt_en {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_EN";
            bindings = <&kp>, <&en_stick>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        layer_activate: layer_activate {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ACTIVATE";
            #binding-cells = <1>;
        };

        layer_deactivate: layer_deactivate {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_DEACTIVATE";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        outs: outs {
            compatible = "zmk,behavior-tap-dance";
            label = "OUTS";
            #binding-cells = <0>;
            bindings = <&out_usb>, <&out_bluetooth>;
        };

        pipe_cmd_dash: pipe_cmd_dash {
            compatible = "zmk,behavior-tap-dance";
            label = "PIPE_CMD_DASH";
            #binding-cells = <0>;
            bindings = <&mt RGUI PIPE>, <&kp KP_MINUS>;

            tapping-term-ms = <300>;
        };

        cmd_lang: cmd_lang {
            compatible = "zmk,behavior-tap-dance";
            label = "CMD_LANG";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&toggle_layout>;
        };

        ctrl_lang: ctrl_lang {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_LANG";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&toggle_layout>;
        };

        twin_e_other: twin_e_other {
            compatible = "zmk,behavior-tap-dance";
            label = "TWIN_E_OTHER";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_IE>, <&kp RU_CYRILLIC_IO>;
        };

        mo_kp: mo_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_KP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        slashes: slashes {
            compatible = "zmk,behavior-tap-dance";
            label = "SLASHES";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;
        };

        slashes_ru_other: slashes_ru_other {
            compatible = "zmk,behavior-tap-dance";
            label = "SLASHES_RU_OTHER";
            #binding-cells = <0>;
            bindings = <&kp RU_SLASH>, <&kp RU_BACKSLASH>;
        };

        slashes_ru_mac: slashes_ru_mac {
            compatible = "zmk,behavior-tap-dance";
            label = "SLASHES_RU_MAC";
            #binding-cells = <0>;
            bindings = <&en SLASH>, <&en BACKSLASH>;
        };

        colons_ru_other: colons_ru_other {
            compatible = "zmk,behavior-tap-dance";
            label = "COLONS_RU_OTHER";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp DOLLAR>;
        };

        asterisk_percent: asterisk_percent {
            compatible = "zmk,behavior-tap-dance";
            label = "ASTERISK_PERCENT";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp PERCENT>;
        };

        asterisk_percent_ru_mac: asterisk_percent_ru_mac {
            compatible = "zmk,behavior-tap-dance";
            label = "ASTERISK_PERCENT_RU_MAC";
            #binding-cells = <0>;
            bindings = <&en ASTERISK>, <&kp DOLLAR>;
        };

        sent_end_ru_other: sent_end_ru_other {
            compatible = "zmk,behavior-tap-dance";
            label = "SENT_END_RU_OTHER";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp EXCLAMATION>;
        };

        under_tilde: under_tilde {
            compatible = "zmk,behavior-tap-dance";
            label = "UNDER_TILDE";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE>, <&kp TILDE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        q1_combo {
            bindings = <&q1>;
            key-positions = <2 1>;
            layers = <6>;
        };

        q2_combo {
            bindings = <&q2>;
            key-positions = <3 1>;
            layers = <6>;
        };

        q3_combo {
            bindings = <&q3>;
            key-positions = <4 1>;
            layers = <6>;
        };

        q4_combo {
            bindings = <&q4>;
            key-positions = <14 1>;
            layers = <6>;
        };

        q1_combo_ru {
            bindings = <&q1_ru>;
            key-positions = <2 1>;
            layers = <7>;
        };

        q2_combo_ru {
            bindings = <&q2_ru>;
            key-positions = <3 1>;
            layers = <7>;
        };

        q3_combo_ru {
            bindings = <&q3_ru>;
            key-positions = <4 1>;
            layers = <7>;
        };

        q4_combo_ru {
            bindings = <&q4_ru>;
            key-positions = <14 1>;
            layers = <7>;
        };

        evo_1_combo {
            bindings = <&evo_1>;
            key-positions = <10 7>;
            layers = <6>;
        };

        evo_2_combo {
            bindings = <&evo_2>;
            key-positions = <10 8>;
            layers = <6>;
        };

        evo_3_combo {
            bindings = <&evo_3>;
            key-positions = <10 9>;
            layers = <6>;
        };

        evo_1_combo_ru {
            bindings = <&evo_1_ru>;
            key-positions = <10 7>;
            layers = <7>;
        };

        evo_2_combo_ru {
            bindings = <&evo_2_ru>;
            key-positions = <10 8>;
            layers = <7>;
        };

        evo_3_combo_ru {
            bindings = <&evo_3_ru>;
            key-positions = <10 9>;
            layers = <7>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&toggle_lang>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&toggle_lang>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to_en &macro_param_1to1 &kp MACRO_PLACEHOLDER &to_ru>;
            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        q1: q1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp N1 &kp SQT &kp N2 &kp N0 &kp N2 &kp N6>;
            label = "Q1";
        };

        q2: q2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp N2 &kp SQT &kp N2 &kp N0 &kp N2 &kp N6>;
            label = "Q2";
        };

        q3: q3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp N3 &kp SQT &kp N2 &kp N0 &kp N2 &kp N6>;
            label = "Q3";
        };

        q4: q4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp N4 &kp SQT &kp N2 &kp N0 &kp N2 &kp N6>;
            label = "Q4";
        };

        swi: swi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp W &kp I &kp UNDER>;
            label = "SWI";
        };

        q1_ru: q1_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &q1 &to_ru>;
            label = "Q1_RU";
        };

        q2_ru: q2_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &q2 &to_ru>;
            label = "Q2_RU";
        };

        q3_ru: q3_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &q3 &to_ru>;
            label = "Q3_RU";
        };

        q4_ru: q4_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &q4 &to_ru>;
            label = "Q4_RU";
        };

        swi_ru: swi_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &swi &to_ru>;
            label = "SWI_RU";
        };

        evo_1: evo_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(E) &kp LS(V) &kp LS(O) &kp DOT &kp N1>;
            label = "EVO_1";
        };

        evo_2: evo_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(E) &kp LS(V) &kp LS(O) &kp DOT &kp N2>;
            label = "EVO_2";
        };

        evo_3: evo_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(E) &kp LS(V) &kp LS(O) &kp DOT &kp N3>;
            label = "EVO_3";
        };

        evo_1_ru: evo_1_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &evo_1 &to_ru>;
            label = "EVO_1_RU";
        };

        evo_2_ru: evo_2_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &evo_2 &to_ru>;
            label = "EVO_2_RU";
        };

        evo_3_ru: evo_3_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &evo_3 &to_ru>;
            label = "EVO_3_RU";
        };

        out_bluetooth: out_bluetooth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &layer_deactivate 1>;
            label = "OUT_BLUETOOTH";
        };

        out_usb: out_usb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB &layer_activate 1>;
            label = "OUT_USB";
        };

        toggle_lang: toggle_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(SPACE))>;
            label = "TOGGLE_LANG";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        toggle_layout: toggle_layout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&toggle_lang &tog 2>;
            label = "TOGGLE_LAYOUT";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        en_bck: en_bck {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN_BCK";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        ampersand_ru: ampersand_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &kp AMPERSAND &to_ru>;
            label = "AMPERSAND_RU";
        };

        pipe_ru: pipe_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &kp PIPE &to_ru>;
            label = "PIPE_RU";
        };

        en_stick: en_stick {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to_en &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "EN_STICK";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&sec_kp_kp LC(D) ESCAPE  &kp Q  &kp W  &kp E  &kp R      &kp T                                                        &kp Y        &kp U      &kp I    &kp O         &kp P      &kp BACKSPACE
&mt LCTRL TAB            &kp A  &kp S  &kp D  &kp F      &kp G                                                        &kp H        &kp J      &kp K    &kp L         &colons    &pipe_ctrl_dash
&mt LSHFT GRAVE          &kp Z  &kp X  &kp C  &kp V      &kp B        &kp DOT             &kp COMMA                   &kp N        &kp M      &eq_not  &under_tilde  &sent_end  &mt RSHFT AT
                                              &cmd_lang  &lt 4 SPACE  &dash_alt_hyphen    &sec_kp_kp LG(ENTER) ENTER  &lt 6 SPACE  &cmd_lang
            >;

            display-name = "En";
        };

        en_other {
            bindings = <
&trans        &trans  &trans  &trans  &trans      &trans                                        &trans  &trans      &trans  &trans  &trans  &trans
&mt LGUI TAB  &trans  &trans  &trans  &trans      &trans                                        &trans  &trans      &trans  &trans  &trans  &pipe_cmd_dash
&trans        &trans  &trans  &trans  &trans      &trans  &trans    &trans                      &trans  &trans      &trans  &trans  &trans  &trans
                                      &ctrl_lang  &trans  &trans    &sec_kp_kp LC(ENTER) ENTER  &trans  &ctrl_lang
            >;
        };

        ru_mac {
            display-name = "Ru_Mac";
            bindings = <
&trans              &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &twin_e_mac                                     &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE  &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &trans
&trans              &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                              &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O    &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &mt RCTRL RU_CYRILLIC_E
&mt_en LSHFT GRAVE  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp AMPERSAND    &kp CARET  &kp RU_CYRILLIC_TE  &twin_sign           &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_HA   &mt_en RSHFT AT
                                                                                       &trans              &trans              &trans           &trans     &trans              &trans
            >;
        };

        ru_other {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &twin_e_other                              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &mt LGUI RU_CYRILLIC_E
&trans  &trans  &trans  &trans  &trans  &trans         &kp RU_DOT    &kp RU_COMMA  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans         &trans        &trans        &trans  &trans
            >;
        };

        nav_mac {
            bindings = <
&kp LC(BACKSLASH)  &none  &kp LC(B)               &kp LC(W)               &kp LA(D)               &kp LC(U)                                                                           &none                     &none                         &kp LA(DELETE)                  &kp LA(BACKSPACE)           &kp DELETE  &trans
&trans             &none  &kp LC(F)               &sec_kp_kp LC(R) LC(P)  &kp LC(N)               &kp LC(D)                                                                           &sec_kp_kp LG(LEFT) LEFT  &sec_kp_kp LG(DOWN) DOWN      &sec_kp_kp LG(UP) UP            &sec_kp_kp LG(RIGHT) RIGHT  &none       &kp LCTRL
&trans             &none  &sec_kp_kp LC(U) LC(B)  &sec_kp_kp LC(A) LA(B)  &sec_kp_kp LC(E) LA(F)  &sec_kp_kp LC(K) LC(F)  &sec_kp_kp LC(Z) LC(C)    &sec_kp_kp LG(LS(N5)) LG(LS(N4))  &kp LEFT                  &sec_kp_kp LG(LEFT) LA(LEFT)  &sec_kp_kp LG(RIGHT) LA(RIGHT)  &kp RIGHT                   &none       &trans
                                                                          &trans                  &trans                  &trans                    &trans                            &mo_kp 9 LA(SPACE)        &trans
            >;

            display-name = "Nav_Mac";
        };

        nav_other {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                                    &trans                    &trans                    &kp LC(DELETE)            &kp LC(BACKSPACE)           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                    &sec_kp_kp LA(LEFT) LEFT  &sec_kp_kp END DOWN       &sec_kp_kp HOME UP        &sec_kp_kp LA(RIGHT) RIGHT  &trans  &kp LGUI
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &sec_kp_kp PRINTSCREEN LA(PRINTSCREEN)  &trans                    &sec_kp_kp HOME LC(LEFT)  &sec_kp_kp END LC(RIGHT)  &trans                      &trans  &trans
                                &trans  &trans  &trans    &trans                                  &trans                    &trans
            >;
        };

        en_sym {
            bindings = <
&swi    &kp LS(Q)   &sec_kp_kp LC(KP_N1) N1  &sec_kp_kp LC(KP_N2) N2  &sec_kp_kp LC(KP_N3) N3  &plus_alt                                      &kp AMPERSAND      &kp PIPE       &braces    &none         &none      &none
&trans  &kp HASH    &sec_kp_kp LC(KP_N4) N4  &sec_kp_kp LC(KP_N5) N5  &sec_kp_kp LC(KP_N6) N6  &kp MINUS                                      &asterisk_percent  &caret_dollar  &brackets  &parenth      &colons    &quotes
&trans  &kp DOLLAR  &sec_kp_kp LC(KP_N7) N7  &sec_kp_kp LC(KP_N8) N8  &sec_kp_kp LC(KP_N9) N9  &sec_kp_kp LC(KP_N0) N0  &kp KP_DOT    &none   &slashes           &lt_gt         &eq_not    &under_tilde  &sent_end  &trans
                                                                      &trans                   &mo 9                    &trans        &trans  &trans             &trans
            >;
        };

        ru_sym_mac {
            bindings = <
&swi_ru  &en LS(Q)       &trans  &trans  &trans  &trans                    &ampersand_ru             &pipe_ru          &braces_ru    &trans  &trans          &trans
&trans   &num HASH HASH  &trans  &trans  &trans  &trans                    &asterisk_percent_ru_mac  &caret_dollar_ru  &brackets_ru  &trans  &colons_ru_mac  &quotes_ru
&trans   &en DOLLAR      &trans  &trans  &trans  &trans  &trans    &trans  &slashes_ru_mac           &lt_gt_ru         &trans        &trans  &trans          &trans
                                         &trans  &trans  &trans    &trans  &trans                    &trans
            >;
        };

        ru_sym_other {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans             &trans  &trans  &trans  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &asterisk_percent  &trans  &trans  &trans  &colons_ru_other    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &slashes_ru_other  &trans  &trans  &trans  &sent_end_ru_other  &trans
                                &trans  &trans  &trans    &trans  &trans             &trans
            >;
        };

        adjust {
            bindings = <
&bt BT_CLR    &none  &sec_kp_kp LA(LS(NUMBER_1)) F1  &sec_kp_kp LA(LS(NUMBER_2)) F2   &sec_kp_kp LA(LS(NUMBER_3)) F3  &sec_kp_kp LA(LS(NUMBER_4)) F4                    &kp LA(R)                       &kp LA(A)          &kp LA(V)        &kp LA(D)   &none  &kp LC(LA(DELETE))
&toggle_lang  &none  &sec_kp_kp LA(LS(NUMBER_5)) F5  &sec_kp_kp LA(LS(NUMBER_6)) F6   &sec_kp_kp LA(LS(NUMBER_7)) F7  &sec_kp_kp LA(LS(NUMBER_8)) F8                    &kp C_PREVIOUS                  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none  &none
&outs         &none  &sec_kp_kp LA(LS(NUMBER_9)) F9  &sec_kp_kp LA(LS(NUMBER_0)) F10  &sec_kp_kp LA(LS(MINUS)) F11    &sec_kp_kp LA(LS(EQUAL)) F12    &none     &none   &sec_kp_kp K_MUTE C_PLAY_PAUSE  &none              &none            &none       &none  &trans
                                                                                      &trans                          &trans                          &trans    &trans  &trans                          &trans
            >;

            display-name = "Adjust";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        override_sym_for_ru {
            if-layers = <6 2>;
            then-layer = <7>;
        };

        fix_ru_for_other {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        override_nav_for_other {
            if-layers = <1 4>;
            then-layer = <5>;
        };

        override_sym_ru_for_other {
            if-layers = <1 7>;
            then-layer = <8>;
        };
    };
};
